# Required. Railway should generate this with ${{secret(48)}} in the template.
API_KEY=replace-with-a-long-random-secret

# Runtime
PORT=8080
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=600
GUNICORN_KEEPALIVE=80
MAX_QUEUE_LENGTH=5
LOCAL_STORAGE_PATH=/tmp/nca-toolkit

# Optional S3-compatible storage. Most media endpoints need cloud storage to
# return their generated files. The Railway template wires these values to a
# Railway Bucket automatically.
# S3_ENDPOINT_URL=https://storage.railway.app
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_BUCKET_NAME=...
# S3_REGION=auto

# Railway Buckets are private. This wrapper returns signed result URLs.
# S3_RETURN_PRESIGNED_URL=true
# S3_PRESIGNED_URL_EXPIRY=604800
# S3_ADDRESSING_STYLE=virtual

# Advanced/testing only. Forces the S3 compatibility adapter for non-Railway
# endpoints such as local MinIO.
# NCA_S3_COMPAT_MODE=false
# S3_PUBLIC_ENDPOINT_URL=
# S3_UPLOAD_ACL=
